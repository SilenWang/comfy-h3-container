# 模型文件（约 43GB，运行 scripts/download_models.sh 生成）
models/

# 生成输出：保留目录本身（output/.gitkeep），确保 clone 后目录存在且属主是
# 当前用户。否则 Docker 会以 root 创建挂载源，容器内以 uid 1000 运行的
# ComfyUI 写不进 output/video，SaveVideo 会报 PermissionError。
output/*
!output/.gitkeep

# 本地环境变量（含密码）
.env

# pixi 环境目录（pixi.lock 需要提交，以保证环境可复现）
.pixi/

# 后台构建的日志 / PID（scripts/build_image.sh 生成）
.build/

# 系统文件
.DS_Store
*.log
