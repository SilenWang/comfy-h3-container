# ── WebUI 认证 ────────────────────────────────────────────────────────────
# 认证来自 ai-dock 基础镜像内置的 caddy 反向代理（HTTP Basic Auth），
# 不是 ComfyUI 自带功能，也不是必须的。ComfyUI 本体没有任何账号体系。
#
# 局域网自用（不想每次输密码，或想让脚本 / MCP 免验证调用）建议直接关闭：
WEB_ENABLE_AUTH=false
#
# ⚠️ 关闭后任何能访问 8188 端口的人都能无密码使用 WebUI 与 API。
#    只在可信局域网内这样用；若机器有公网暴露，请保持 true 或改用防火墙限制来源。
#    只想本机访问（连局域网也不开）可把 docker-compose.yml 的端口映射改成
#    "127.0.0.1:8188:8188"。
#
# WEB_ENABLE_AUTH=true 时生效的密码（WebUI 账号固定为 user）
WEB_PASSWORD=change-me-please

# 对外端口（ComfyUI WebUI / API）
# COMFYUI_PORT_HOST=8188

# ── 模型 / 输出目录（可选）────────────────────────────────────────────────
# 默认用仓库内的 ./models 和 ./output。想让多个项目 / 多台机器共用同一份模型、
# 避免每次重建都重新下载 43GB，就把 MODELS_DIR 指向外部目录（绝对路径，
# 或相对本文件）。OUTPUT_DIR 同理。
# 注意：目录需提前创建且属主可写，别让 Docker 以 root 去创建。
# MODELS_DIR=/data/ai-models/comfy-h3
# OUTPUT_DIR=/data/ai-output/comfy-h3
# 下载脚本也会写入 MODELS_DIR：MODELS_DIR=/data/ai-models/comfy-h3 pixi run models base
# 若模型目录是只读共享盘，可在 compose 里把挂载改成 "${MODELS_DIR}:/workspace/models:ro"。

# ── 空闲自动释放（容器内 comfyui-idle-free，supervisor 托管）────────────────
# ComfyUI 跑完任务**不会**自己释放内存/显存：模型留在显存（显存不够就卸载到内存继续
# 留着），节点中间结果与读盘产生的页缓存同样算在容器内存里。内存受限时（compose 的
# memory 上限），跨模型族连续调用会把常驻占用越堆越高，后面的任务被换页拖死甚至 OOM。
# 容器内守护会在队列空闲后自动调 ComfyUI 的 /free 回收（等价于 WebUI 的
# 「Free model and node cache」），并丢弃模型文件的页缓存（/free 不动它）。
# 手动释放：pixi run free；查看内存明细：pixi run mem-status
# COMFYUI_IDLE_FREE_ENABLE=true    # 默认开启；false / 0 / no / off 关闭
# COMFYUI_IDLE_FREE_SECONDS=60     # 队列空闲多少秒后释放（最小 5）。
#                                  # 想优先「连续任务复用模型的加载速度」可调大，如 600
# COMFYUI_IDLE_FREE_POLL=3         # 轮询间隔秒数（一般不用改）
# COMFYUI_IDLE_FREE_DROP_FILE_CACHE=true   # 是否丢弃模型文件页缓存（默认开）
# COMFYUI_IDLE_FREE_FILE_CACHE_MIN_MB=512  # 页缓存高于该值才丢弃（MB）
# COMFYUI_IDLE_FREE_RESTART_SECONDS=0      # 空闲释放后再空闲 N 秒重启 ComfyUI（0=关闭）
#                                          # 用于回收 anon/pinned；一般不用开
# COMFYUI_IDLE_FREE_RESTART_MIN_ANON_MB=4096  # 重启阈值（anon+pinned）
# 改完需 `docker compose up -d` 重建容器才生效（restart 不会重读 .env）。
# 旧镜像里的运行中容器可 `pixi run mem-install` 热更新守护与页缓存脚本，无需重建镜像。

# ── artokun MCP（容器内 supervisor 托管服务，可选配置）─────────────────────
# 容器内以 Streamable HTTP 暴露，宿主端口见 docker-compose.yml（默认 0.0.0.0:9100，
# 同机其他容器 / 局域网都可访问）。
# 远程客户端需带 Authorization: Bearer <token>（或 X-API-Key: <token>）。
# 默认值为 comfy-h3-mcp，形同公开 —— 端口默认已对所有接口开放，
# 请在首次 `pixi run up` 前改成强随机值（生成：openssl rand -hex 16）：
# COMFYUI_MCP_HTTP_TOKEN=change-me-too

# 端口（宿主:容器 两端联动，改一处即可，映射始终对齐；默认 9100:19100）：
# 只允许宿主机本机访问：把 COMFYUI_MCP_PORT_HOST 写成 "127.0.0.1:9100"。
# COMFYUI_MCP_PORT_HOST=9100     # 宿主端口（不写 IP 即绑所有接口）
# COMFYUI_MCP_PORT_LOCAL=19100   # 容器内监听端口
